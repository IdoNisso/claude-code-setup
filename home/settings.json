{
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:5",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/block-secrets:~/.claude/mods/commit-lint:~/.claude/mods/sync-drift"
  },
  "model": "claude-opus-5-5[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(cat */.env*)",
      "Bash(cat *.env*)",
      "Bash(less */.env*)",
      "Bash(less *.env*)",
      "Bash(more */.env*)",
      "Bash(more *.env*)",
      "Bash(head */.env*)",
      "Bash(head *.env*)",
      "Bash(tail */.env*)",
      "Bash(tail *.env*)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(set)",
      "Bash(export -p *)",
      "Read(*/.env*)",
      "Read(*.env*)",
      "Edit(*/.env*)",
      "Edit(*.env*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.netrc)",
      "Read(~/.claude/.credentials.json)"
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "effortLevel": "medium",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
